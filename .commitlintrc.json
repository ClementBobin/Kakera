{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "chore", "docs", "style", "refactor", "test", "perf", "ci"]
    ],
    "scope-enum": [
      2,
      "always",
      ["library", "player", "sync", "settings", "calendar", "ui", "backend", "deps"]
    ]
  }
}
